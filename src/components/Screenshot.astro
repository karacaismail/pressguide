---
import type { Step } from '../types';
const {
  screenshot,
  id,
  detail = false,
} = Astro.props as {
  screenshot: NonNullable<Step['screenshot']>;
  id: string;
  detail?: boolean;
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/${screenshot.src.replace(/^\//, '')}`;
const clamp = (value: number, minimum: number, maximum: number) =>
  Math.min(maximum, Math.max(minimum, value));
const frames = screenshot.annotations.map((annotation) => {
  if (
    !annotation.bounds &&
    (typeof annotation.targetX !== 'number' ||
      typeof annotation.targetY !== 'number')
  ) {
    throw new Error(
      `Screenshot ${id}: each annotation requires bounds or a legacy target coordinate.`,
    );
  }
  const bounds = annotation.bounds ?? {
    x: (annotation.targetX ?? 50) - 6,
    y: (annotation.targetY ?? 50) - 2.5,
    width: 12,
    height: 5,
  };
  const width = clamp(bounds.width, 0.1, 100);
  const height = clamp(bounds.height, 0.1, 100);
  return {
    x: clamp(bounds.x, 0, 100 - width),
    y: clamp(bounds.y, 0, 100 - height),
    width,
    height,
  };
});
---

<figure class="evidence">
  <a
    class="image-link"
    href={detail ? src : `${base}/steps/${id}/`}
    target="_blank"
    rel="noopener"
    aria-label={`${screenshot.alt} — açıklamalı ekranı aç`}
  >
    <div class="image-stage">
      <div class="image-surface">
        <img
          src={src}
          alt={screenshot.alt}
          width={screenshot.width}
          height={screenshot.height}
          loading="lazy"
          decoding="async"
        />
        <svg
          class="annotations"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          {frames.map((frame, index) => (
            <rect
              x={frame.x}
              y={frame.y}
              width={frame.width}
              height={frame.height}
              data-annotation-number={index + 1}
              vector-effect="non-scaling-stroke"
            />
          ))}
        </svg>
      </div>
      {frames.map((frame, index) => (
        <span
          class="annotation-reference"
          style={`--annotation-y:${frame.y + frame.height / 2}%`}
          aria-hidden="true"
        >
          {index + 1}
        </span>
      ))}
    </div>
  </a>
  <figcaption>
    <p>
      {screenshot.alt}. İnce çerçeveler aşağıdaki numaralı açıklamalarda
      belirtilen alanları gösterir.
    </p>
    <ol>
      {screenshot.annotations.map((annotation) => (
        <li>{annotation.label}</li>
      ))}
    </ol>
    <p>
      <a class="original-image-link" href={src} target="_blank" rel="noopener">
        İşaretsiz özgün ekran görüntüsünü aç
      </a>
    </p>
  </figcaption>
</figure>
