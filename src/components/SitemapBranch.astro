---
import SitemapNavigation from './SitemapNavigation.astro';
import {
  formatObservation,
  functionalTestLabels,
  kindLabels,
  nearestLinkedAncestor,
  pressUrl,
  riskLabels,
  sourceLabels,
  statusLabels,
  surfaceLabels,
  type SitemapNode,
} from '../sitemap';
import { metadataPath } from '../sitemap-partitions';
const {
  node,
  byId,
  childrenOf,
  anchorIds,
  anchorId,
  base,
  primaryIds,
  homeById,
} = Astro.props as {
  node: SitemapNode;
  /** Full dataset, for nearest linked ancestor lookup only. */
  byId: Map<string, SitemapNode>;
  /** Children within the current detail view only. */
  childrenOf: Map<string, SitemapNode[]>;
  anchorIds: Set<string>;
  /** Anchor whose detail document this is. */
  anchorId: string;
  base: string;
  /** Nodes with full metadata in this part; all nodes are full when absent. */
  primaryIds?: Set<string>;
  /** Home metadata part of each owned node, for lean context links. */
  homeById?: Map<string, { anchorId: string; part: number }>;
};
const primary = !primaryIds || primaryIds.has(node.id);
const home = homeById?.get(node.id);
const homeHref = home ? metadataPath(home.anchorId, home.part, base) : '';
const children = childrenOf.get(node.id) ?? [];
const href = node.livePath ? pressUrl(node.livePath) : undefined;
const ancestor = href ? undefined : nearestLinkedAncestor(node, byId);
const ancestorHref = ancestor?.livePath ? pressUrl(ancestor.livePath) : '';
const observed = formatObservation(node);
// Non-visible paths only; visible summary and body text is indexed client-side.
const search = [node.routeTemplate, node.livePath].filter(Boolean).join(' ');
---

{!primary ? (
  <li
    class="sitemap-item"
    data-node-id={node.id}
    data-kind={node.kind}
    data-surface={node.surface}
    data-status={node.status}
    data-source={node.source}
    data-search=""
    data-metadata-context
  >
    <details class="sitemap-node" data-sitemap-node>
      <summary>
        <span class="sitemap-label">{node.label}</span>
        <span class="sitemap-status" data-status={node.status}>
          {statusLabels[node.status]}
        </span>
        <span class="sitemap-source" data-source={node.source}>
          {sourceLabels[node.source]}
        </span>
      </summary>
      <div class="sitemap-body">
        <p data-search-text>
          {kindLabels[node.kind]}, {surfaceLabels[node.surface]}
        </p>
        {homeHref && (
          <a
            class="sitemap-link"
            href={homeHref}
            aria-label={`Tüm ayrıntılar: ${node.label}`}
          >
            Tüm ayrıntılar
          </a>
        )}
        {children.length > 0 && (
          <>
            <p class="sitemap-filtered-children" hidden>
              Alt öğeler süzüldü.
            </p>
            <ul class="sitemap-tree">
              {children.map((child) => (
                <Astro.self
                  node={child}
                  byId={byId}
                  childrenOf={childrenOf}
                  anchorIds={anchorIds}
                  anchorId={anchorId}
                  base={base}
                  primaryIds={primaryIds}
                  homeById={homeById}
                />
              ))}
            </ul>
          </>
        )}
      </div>
    </details>
  </li>
) : (
  <li
    class="sitemap-item"
    data-node-id={node.id}
    data-kind={node.kind}
    data-surface={node.surface}
    data-status={node.status}
    data-source={node.source}
    data-search={search}
    data-metadata-primary={primaryIds ? '' : undefined}
  >
    <details class="sitemap-node" data-sitemap-node>
      <summary>
        <span class="sitemap-label">{node.label}</span>
        <span class="sitemap-status" data-status={node.status}>
          {statusLabels[node.status]}
        </span>
        <span class="sitemap-source" data-source={node.source}>
          {sourceLabels[node.source]}
        </span>
      </summary>
      <div class="sitemap-body">
        <dl class="sitemap-meta" data-search-text>
          <div>
            <dt>Tür:</dt>
            <dd>
              {kindLabels[node.kind]}, {surfaceLabels[node.surface]}
            </dd>
          </div>
          <div>
            <dt>Gözlem kaynağı:</dt>
            <dd>{sourceLabels[node.source]}</dd>
          </div>
          {observed && (
            <div>
              <dt>Gözlem zamanı:</dt>
              <dd>
                <time datetime={observed.datetime}>{observed.text}</time>
              </dd>
            </div>
          )}
          {node.routeTemplate && (
            <div>
              <dt>Yol şablonu:</dt>
              <dd>
                <code>{node.routeTemplate}</code>
              </dd>
            </div>
          )}
          <div>
            <dt>Risk:</dt>
            <dd data-risk={node.risk}>
              {riskLabels[node.risk]}, çalıştırılmadı
            </dd>
          </div>
          <div>
            <dt>İşlev testi:</dt>
            <dd>{functionalTestLabels[node.functionalTest]}</dd>
          </div>
        </dl>
        {node.notes && (
          <ul class="sitemap-notes" aria-label="Notlar" data-search-text>
            {node.notes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        )}
        {node.options && (
          <div class="sitemap-options" data-search-text>
            <p>Görülen seçenekler:</p>
            <ul class="sitemap-notes">
              {node.options.map((option) => (
                <li>{option}</li>
              ))}
            </ul>
          </div>
        )}
        {href ? (
          <p>
            Kaydedilen bağlantı; bu öğenin işlev testi yapılmadıysa açılması
            çalıştığını göstermez:{' '}
            <a
              class="sitemap-link"
              href={href}
              target="_blank"
              rel="noopener"
              data-live-link
            >
              Press’te aç: <code>{node.livePath}</code>
            </a>
          </p>
        ) : ancestor && ancestorHref ? (
          <p>
            Bu öğenin kaydedilmiş kendi bağlantısı yok. En yakın üst sayfanın
            kaydedilen bağlantısı:{' '}
            <a
              class="sitemap-link"
              href={ancestorHref}
              target="_blank"
              rel="noopener"
              data-live-link
            >
              {ancestor.label}
            </a>
          </p>
        ) : (
          <p>Kaydedilmiş Press bağlantısı yok.</p>
        )}
        {children.length > 0 && (
          <>
            <p class="sitemap-filtered-children" hidden>
              Alt öğeler süzüldü.
            </p>
            <ul class="sitemap-tree">
              {children.map((child) =>
                anchorIds.has(child.id) && child.id !== anchorId ? (
                  <SitemapNavigation
                    node={child}
                    childrenOf={childrenOf}
                    anchorIds={anchorIds}
                    base={base}
                    placeholder
                  />
                ) : (
                  <Astro.self
                    node={child}
                    byId={byId}
                    childrenOf={childrenOf}
                    anchorIds={anchorIds}
                    anchorId={anchorId}
                    base={base}
                    primaryIds={primaryIds}
                    homeById={homeById}
                  />
                ),
              )}
            </ul>
          </>
        )}
      </div>
    </details>
  </li>
)}
