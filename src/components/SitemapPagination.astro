---
const { part, totalParts, hrefFor, label } = Astro.props as {
  /** 1-based current part. */
  part: number;
  totalParts: number;
  /** Static URL of a part; only fixed neighbours are linked. */
  hrefFor: (part: number) => string;
  label: string;
};
---

{totalParts > 1 && (
  <nav class="sitemap-pagination" aria-label={label} data-sitemap-pagination>
    <p>
      Parça {part} / {totalParts}
    </p>
    <ul>
      {part > 1 && (
        <>
          <li>
            <a class="sitemap-link" href={hrefFor(1)}>
              İlk parça
            </a>
          </li>
          <li>
            <a class="sitemap-link" href={hrefFor(part - 1)} rel="prev">
              Önceki parça
            </a>
          </li>
        </>
      )}
      {part < totalParts && (
        <>
          <li>
            <a class="sitemap-link" href={hrefFor(part + 1)} rel="next">
              Sonraki parça
            </a>
          </li>
          <li>
            <a class="sitemap-link" href={hrefFor(totalParts)}>
              Son parça
            </a>
          </li>
        </>
      )}
    </ul>
  </nav>
)}
