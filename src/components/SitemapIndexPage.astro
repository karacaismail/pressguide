---
import SitemapControls from './SitemapControls.astro';
import SitemapNavigation from './SitemapNavigation.astro';
import SitemapPagination from './SitemapPagination.astro';
import { compiledSitemapScript } from '../sitemap-script';
import { detailPath } from '../sitemap-views';
import {
  buildSitemapPartitions,
  childIndexPath,
  globalIndexPath,
} from '../sitemap-partitions';
import { loadSitemap, type SitemapNode } from '../sitemap';
import '../styles/global.css';
import '../styles/sitemap.css';
const { ownerId, part } = Astro.props as {
  /** Owning anchor for a child index; null for the global index. */
  ownerId: string | null;
  part: number;
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sitemap = await loadSitemap();
const partitions = buildSitemapPartitions(sitemap?.nodes ?? []);
const { views } = partitions;
const parts = ownerId
  ? partitions.childrenFor(ownerId)
  : partitions.globalIndexParts;
const current = parts.find((candidate) => candidate.part === part);
if (!current)
  throw new Error(
    `sitemap index part ${part} for "${ownerId ?? 'global'}" does not exist`,
  );
const owner = ownerId ? views.byId.get(ownerId) : undefined;
const hrefFor = (target: number) =>
  ownerId
    ? childIndexPath(ownerId, target, base)
    : globalIndexPath(target, base);
const crumbs = owner ? [...views.breadcrumbsFor(owner.id), owner] : [];
// Flat list: entries never render each other's subtree.
const noChildren = new Map<string, SitemapNode[]>();
const mapHref = `${base}/sitemap/`;
const title = owner
  ? `${owner.label}: alt sayfa ve bölümler`
  : 'Tüm sayfa ve bölümler';
const partText =
  current.totalParts > 1
    ? ` (parça ${current.part} / ${current.totalParts})`
    : '';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`Press panel haritası: ${title}${partText}.`}
    />
    <meta name="theme-color" content="#18312e" />
    <title>
      {title}
      {partText} — Press panel haritası
    </title>
  </head>
  <body>
    <a class="skip-link" href="#panel-agaci">
      Listeye geç
    </a>
    <header class="wrap masthead">
      <a class="button secondary" href={`${base}/`}>
        Rehbere dön
      </a>
    </header>
    <main class="wrap sitemap">
      <nav class="sitemap-breadcrumbs" aria-label="Konum">
        <ol>
          <li>
            <a class="sitemap-link" href={mapHref}>
              Press panel haritası
            </a>
          </li>
          {crumbs.map((crumb) => (
            <li>
              {views.anchorIds.has(crumb.id) ? (
                <a class="sitemap-link" href={detailPath(crumb.id, base)}>
                  {crumb.label}
                </a>
              ) : (
                <span>{crumb.label}</span>
              )}
            </li>
          ))}
          <li aria-current="page">{title}</li>
        </ol>
      </nav>

      <section class="sitemap-intro" aria-labelledby="sitemap-title">
        <p class="sitemap-phase">Dizin</p>
        <h1 id="sitemap-title">{title}</h1>
        <aside class="status sitemap-notice" aria-label="İnceleme sınırları">
          <p>İnceleme, işlev testi değildir.</p>
          <p>Press bağlantıları oturum açmayı gerektirir.</p>
          <p>
            Hiçbir kaydetme, değiştirme veya silme işlemi çalıştırılmadı. Yazma
            ve yıkıcı eylemler yalnızca görüldükleri için listelenir.
          </p>
        </aside>
        <p>
          {owner
            ? 'Bu liste bu öğenin hemen altındaki, kendi ayrıntı sayfası olan sayfa ve bölümleri gösterir.'
            : 'Bu liste ayrıntı sayfası olan tüm sayfa ve bölümleri veri sırasıyla gösterir.'}{' '}
          Her satırda durum ve gözlem kaynağı görünür; bileşenler ayrıntı
          sayfalarındadır.
        </p>
      </section>

      <section
        class="sitemap-section"
        id="panel-agaci"
        aria-labelledby="agac-baslik"
      >
        <h2 id="agac-baslik">Liste{partText}</h2>
        <SitemapPagination
          part={current.part}
          totalParts={current.totalParts}
          hrefFor={hrefFor}
          label="Liste parçaları"
        />
        <SitemapControls
          nodes={current.nodes}
          scope={`Arama yalnızca bu parçada${partText} listelenen öğelerin adını, türünü, kaynağını, durumunu ve yolunu okur; diğer parçaları ve bileşen ayrıntılarını aramaz.`}
        />
        <ul class="sitemap-tree" data-sitemap>
          {current.nodes.map((node) => (
            <SitemapNavigation
              node={node}
              childrenOf={noChildren}
              anchorIds={views.anchorIds}
              base={base}
              placeholder
            />
          ))}
        </ul>
      </section>
    </main>
    <footer class="wrap">
      <p>
        Kayıt değerleri, e-posta, iletişim bilgisi, tutar, anahtar ve müşteri
        tanımlayıcıları yayımlanmaz.
      </p>
    </footer>
    <script is:inline type="module" set:html={compiledSitemapScript} />
  </body>
</html>
