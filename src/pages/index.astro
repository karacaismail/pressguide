---
import { readFile } from 'node:fs/promises';
import {
  BookOpenIcon,
  ArrowDownIcon,
  ListChecksIcon,
  TreeStructureIcon,
} from '@phosphor-icons/react/ssr';
import Screenshot from '../components/Screenshot.astro';
import type { Guide } from '../types';
import '../styles/global.css';
let guide: Guide = {
  title: 'Press eğitim rehberi',
  subtitle:
    'Uygulama kaynağından çalışan eğitim sitesine: somut adımlar ve ekran kanıtları.',
  updated: '7 Ekim 2026',
  liveStatus:
    'Canlı doğrulama sürüyor. Tarihsel ekran görüntüsü işlemin bugünkü durumunu kanıtlamaz.',
  steps: [],
  questions: [],
  sources: [],
};
try {
  guide = JSON.parse(
    await readFile(
      new URL('src/data/guide.json', `file://${process.cwd()}/`),
      'utf8',
    ),
  ) as Guide;
} catch (error) {
  if (!(error instanceof Error && 'code' in error && error.code === 'ENOENT'))
    throw error;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const primaryIds = [
  'team',
  'server',
  'apps',
  'source-form',
  'candidate',
  'schedule',
  'site',
  'hata-tanisi',
];
const primarySteps = primaryIds.flatMap((id) =>
  guide.steps.filter((step) => step.id === id),
);
const remainingSteps = guide.steps.filter(
  (step) => !primaryIds.includes(step.id),
);
const statuses = {
  historical: 'Tarihsel ekran kaydı',
  live: 'Canlı oturumda doğrulandı',
  pending: 'Doğrulama bekliyor',
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={guide.subtitle} />
    <meta name="theme-color" content="#18312e" />
    <title>{guide.title} — uygulamalı kurulum notları</title>
  </head>
  <body>
    <a class="skip-link" href="#adimlar">
      Adımlara geç
    </a>
    <header class="wrap masthead">
      <span class="brand">
        <BookOpenIcon className="icon" aria-hidden="true" /> Press / çalışma
        defteri
      </span>
      <span class="edition">Güncelleme: {guide.updated}</span>
    </header>
    <main>
      <section class="wrap hero" aria-labelledby="title">
        <div class="eyebrow">Kurulumdan kullanıma</div>
        <h1 id="title">{guide.title}</h1>
        <p>{guide.subtitle}</p>
        <div class="hero-actions">
          <a class="button" href="#adimlar">
            <ArrowDownIcon className="icon" aria-hidden="true" /> Adım adım
            ilerle
          </a>
          <a class="button secondary" href={`${base}/sitemap/`}>
            <TreeStructureIcon className="icon" aria-hidden="true" /> Press
            panel haritasını aç
          </a>
          <button class="button secondary" id="checklist-trigger" type="button">
            <ListChecksIcon className="icon" aria-hidden="true" /> Kendi kontrol
            listemi aç
          </button>
        </div>
        <p
          id="enhancement-status"
          class="enhancement-error"
          role="status"
          hidden
        ></p>
        <noscript>
          <p>
            Etkileşimli kontrol listesi için JavaScript gerekir. Aşağıdaki bütün
            adımlar ve ekran notları okumaya açıktır.
          </p>
        </noscript>
      </section>
      <div class="wrap">
        <aside class="status" aria-label="Doğrulama durumu">
          <h2>Bu rehberin durumu</h2>
          <p>{guide.liveStatus}</p>
        </aside>
        <nav class="toc" aria-label="Rehber bölümleri">
          <h2>İzlenecek yol</h2>
          <ol>
            {primarySteps.map((step) => (
              <li>
                <a href={`#${step.id}`}>{step.title}</a>
              </li>
            ))}
          </ol>
          {guide.steps.length === 0 && (
            <p>
              Ekran kanıtları inceleniyor. Adımlar doğrulandıkça burada
              yayımlanacak.
            </p>
          )}
        </nav>
        <section class="steps" id="adimlar" aria-label="Uygulama adımları">
          {primarySteps.map((step, index) => (
            <article class="step" id={step.id}>
              <div class="step-heading">
                <span class="step-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h2>{step.title}</h2>
              </div>
              <p class="step-summary">{step.summary}</p>
              <span class="step-status">{statuses[step.status]}</span>
              <div class="step-content">
                <div class="step-copy">
                  <h3>Uygula</h3>
                  <ol>
                    {step.actions.map((action) => (
                      <li>{action}</li>
                    ))}
                  </ol>
                  {step.notes.length > 0 && (
                    <details class="notes">
                      <summary>Gerekli notlar</summary>
                      <ul>
                        {step.notes.map((note) => (
                          <li>{note}</li>
                        ))}
                      </ul>
                    </details>
                  )}
                  <div class="verification">
                    <h3>Kontrol et</h3>
                    <p>{step.verification}</p>
                  </div>
                </div>
                {step.screenshot && (
                  <Screenshot screenshot={step.screenshot} id={step.id} />
                )}
              </div>
            </article>
          ))}
        </section>
        <details class="history">
          <summary>Ayrıntılar ve önceki kontroller</summary>
          {remainingSteps.map((step) => (
            <details id={step.id}>
              <summary>{step.title}</summary>
              <p>{statuses[step.status]}</p>
              <ol>
                {step.actions.map((action) => (
                  <li>{action}</li>
                ))}
              </ol>
              <ul>
                {step.notes.map((note) => (
                  <li>{note}</li>
                ))}
              </ul>
              <p>Kontrol: {step.verification}</p>
              {step.screenshot && (
                <a href={`${base}/steps/${step.id}/`}>Ekran kanıtını aç</a>
              )}
            </details>
          ))}
        </details>
      </div>
      {guide.questions.length > 0 && (
        <section class="faq" id="sorular">
          <div class="wrap">
            <h2>Sık karşılaşılan sorular</h2>
            {guide.questions.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}
      {guide.sources.length > 0 && (
        <section class="wrap sources">
          <h2>Kaynaklar ve kontrol noktaları</h2>
          <ul>
            {guide.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener">
                  {source.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>
    <footer class="wrap">
      <p>
        Eğitim rehberi. Kimlik bilgileri ve gizli erişim değerleri yayımlanmaz.
        Her adımın doğrulama durumunu dikkate alın.
      </p>
    </footer>
    <div id="checklist-host"></div>
    <script
      id="checklist-data"
      type="application/json"
      set:html={JSON.stringify(
        primarySteps.map(({ id, title }) => ({ id, title })),
      ).replace(/</g, '\\u003c')}
    />
    <script>
      function revealAnchor() {
        let id: string;
        try {
          id = decodeURIComponent(location.hash.slice(1));
        } catch {
          return;
        }
        let node = document.getElementById(id);
        while (node) {
          if (node instanceof HTMLDetailsElement) node.open = true;
          node = node.parentElement;
        }
      }
      revealAnchor();
      window.addEventListener('hashchange', revealAnchor);
      import mantineStyles from '@mantine/core/styles.css?url';
      let stylesReady: Promise<void> | undefined;
      function loadChecklistStyles() {
        stylesReady ??= new Promise<void>((resolve, reject) => {
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = mantineStyles;
          link.onload = () => resolve();
          link.onerror = () => {
            link.remove();
            stylesReady = undefined;
            reject(new Error('styles'));
          };
          document.head.prepend(link);
        });
        return stylesReady;
      }
      const trigger =
        document.querySelector<HTMLButtonElement>('#checklist-trigger');
      const host = document.querySelector<HTMLElement>('#checklist-host');
      const status = document.querySelector<HTMLElement>('#enhancement-status');
      trigger?.addEventListener('click', async () => {
        if (!host || !status) return;
        trigger.disabled = true;
        status.hidden = true;
        try {
          await loadChecklistStyles();
          const { openChecklist } = await import('../enhancement');
          const steps = JSON.parse(
            document.querySelector('#checklist-data')?.textContent || '[]',
          );
          openChecklist(host, steps, trigger);
        } catch {
          status.textContent =
            'Kontrol listesi yüklenemedi. Tekrar deneyebilir veya aşağıdaki adımlarla devam edebilirsiniz.';
          status.hidden = false;
        } finally {
          trigger.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style>
  .notes > summary,
  .history summary {
    min-block-size: var(--target-size);
    padding-block: var(--space-sm);
    cursor: pointer;
    color: var(--color-accent);
    font-weight: 700;
  }
  .history {
    margin-block: var(--space-lg);
    overflow-wrap: break-word;
  }
  .history > details {
    padding-block: var(--space-sm);
  }
  .history a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
  }
</style>
