---
import SitemapNavigation from '../components/SitemapNavigation.astro';
import { compiledSitemapScript } from '../sitemap-script';
import { buildSitemapEntry } from '../sitemap-partitions';
import {
  formatObservation,
  kindLabels,
  loadSitemap,
  riskLabels,
  sourceLabels,
  statusDefinitions,
  statusLabels,
  type Kind,
  type Risk,
  type SitemapNode,
  type Source,
  type Status,
} from '../sitemap';
import '../styles/global.css';
import '../styles/sitemap.css';
import '../styles/sitemap-inline.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sitemap = await loadSitemap();
const nodes = sitemap?.nodes ?? [];
const entry = buildSitemapEntry(nodes);
const { views } = entry;
// Top-level anchors plus unowned navigation context only.
const viewNodes = entry.rootNodes;
const viewIds = new Set(viewNodes.map((node) => node.id));
const childrenOf = new Map<string, SitemapNode[]>();
for (const node of viewNodes)
  if (node.parentId && viewIds.has(node.parentId))
    childrenOf.set(node.parentId, [
      ...(childrenOf.get(node.parentId) ?? []),
      node,
    ]);
const roots = viewNodes.filter(
  (node) => node.parentId === null || !viewIds.has(node.parentId),
);
const globalIndexHref = '#tum-ogeler';
// Counts always describe the full dataset, not this navigation view.
const countBy = <T extends string>(
  labels: Record<T, string>,
  pick: (node: SitemapNode) => T,
  from: SitemapNode[] = nodes,
) =>
  (Object.keys(labels) as T[]).map((key) => ({
    key,
    label: labels[key],
    count: from.filter((node) => pick(node) === key).length,
  }));
const pages = nodes.filter((node) => node.kind === 'page');
const countGroups: {
  title: string;
  notes?: string[];
  items: { key: string; label: string; count: number }[];
}[] = [
  {
    title: 'Öğe türüne göre',
    notes: ['Sayfası olmayan bölümler bölüm olarak sayılır.'],
    items: countBy<Kind>(kindLabels, (node) => node.kind).filter(
      (item) => item.count > 0,
    ),
  },
  {
    title: 'Sayfalar gözlem kaynağına göre',
    items: countBy<Source>(sourceLabels, (node) => node.source, pages),
  },
  {
    title: 'Duruma göre',
    items: countBy<Status>(statusLabels, (node) => node.status),
  },
  {
    title: 'Gözlem kaynağına göre',
    items: countBy<Source>(sourceLabels, (node) => node.source),
  },
  {
    title: 'Risk türüne göre (hiçbiri çalıştırılmadı)',
    items: countBy<Risk>(riskLabels, (node) => node.risk),
  },
];
// Same explicit UTC convention as node observations; datetime stays raw.
const lastUpdated =
  sitemap && formatObservation({ observedAt: sitemap.lastUpdated })?.text;
const inProgress = !sitemap || sitemap.auditPhase === 'in_progress';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Press Dashboard ve Desk ekranlarının okuma amaçlı incelenmiş haritası."
    />
    <meta name="theme-color" content="#18312e" />
    <title>Press panel haritası — Press eğitim rehberi</title>
  </head>
  <body>
    <a class="skip-link" href="#panel-agaci">
      Panel ağacına geç
    </a>
    <header class="wrap masthead">
      <a class="button secondary" href={`${base}/`}>
        Rehbere dön
      </a>
      {sitemap && (
        <span class="edition">
          Son güncelleme:{' '}
          <time datetime={sitemap.lastUpdated}>{lastUpdated}</time>
        </span>
      )}
    </header>
    <main class="wrap sitemap">
      <section class="sitemap-intro" aria-labelledby="sitemap-title">
        {inProgress ? (
          <p class="sitemap-phase">Tarama sürüyor</p>
        ) : (
          <p class="sitemap-phase">Belirtilen kapsam tamamlandı</p>
        )}
        <h1 id="sitemap-title">Press panel haritası</h1>
        <p class="sitemap-lead">
          {inProgress
            ? `Açılmayan yollar “${statusLabels.discovered}” durumundadır.`
            : 'Aşağıda yazılı kapsamın taraması bitti. Bu, kapsam dışındaki dinamik kayıtların açıldığı ya da yazma işlemlerinin denendiği anlamına gelmez.'}
        </p>
        {globalIndexHref && (
          <p>
            <a class="sitemap-link" href={globalIndexHref} data-global-index>
              Tüm öğeleri ara
            </a>
          </p>
        )}
        <aside class="status sitemap-notice" aria-label="İnceleme sınırları">
          <p>İnceleme, işlev testi değildir.</p>
          <p>Press bağlantıları oturum açmayı gerektirir.</p>
          <p>
            Kaydetme, değiştirme ve silme çalıştırılmadı. Eylemler yalnızca
            gözlem kaydıdır.
          </p>
        </aside>
      </section>

      <section
        class="sitemap-section"
        id="panel-agaci"
        aria-labelledby="agac-baslik"
      >
        <h2 id="agac-baslik">Panel ağacı</h2>
        {roots.length > 0 ? (
          <>
            <p>Sayfa, alan ve eylemleri burada açın.</p>
            <ul class="sitemap-tree" data-sitemap>
              {roots.map((node) => (
                <SitemapNavigation
                  node={node}
                  childrenOf={childrenOf}
                  anchorIds={views.anchorIds}
                  base={base}
                />
              ))}
            </ul>
          </>
        ) : (
          <p>Henüz harita öğesi yok. Tarama sürüyor.</p>
        )}
      </section>

      <section
        class="sitemap-section"
        id="tum-ogeler"
        aria-labelledby="tum-baslik"
        data-explorer
        data-url={`${base}/press-sitemap.json`}
      >
        <h2 id="tum-baslik">Tüm öğeler</h2>
        <button class="button" data-load hidden>
          Tüm öğeleri aç
        </button>
        <div class="sitemap-controls" data-controls hidden>
          <label for="sitemap-search">Tüm kayıtlarda ara</label>
          <input
            id="sitemap-search"
            type="search"
            placeholder="Ad, kimlik, yol veya not"
          />
        </div>
        <p data-result-count role="status" aria-live="polite"></p>
        <ul class="sitemap-tree" data-results></ul>
        <nav
          class="sitemap-inline-paging"
          aria-label="Sonuç sayfaları"
          data-paging
          hidden
        >
          <button class="button secondary" data-prev>
            Önceki
          </button>
          <span data-page></span>
          <button class="button secondary" data-next>
            Sonraki
          </button>
        </nav>
        <section data-selected aria-label="Seçili öğe"></section>
        <noscript>
          <p>
            Ayrıntıları ve tüm kayıtları aşağıdaki JSON bağlantısından
            okuyabilirsiniz. Etkileşimli arama JavaScript gerektirir.
          </p>
        </noscript>
      </section>

      <section class="sitemap-section" aria-labelledby="kapsam">
        <h2 id="kapsam">Tarama kapsamı</h2>
        {sitemap ? (
          <details class="sitemap-coverage" data-coverage-details>
            <summary>Tarama kapsamı, kapsam dışı ve öğe sayıları</summary>
            <ul>
              {sitemap.coverageScope.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <h3>Kapsam dışı</h3>
            <ul>
              {sitemap.exclusions.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <h3>Öğe sayıları</h3>
            <p>
              Toplam {nodes.length} öğe: ekran, sekme, alan ve eylemler. Sayılar
              tüm veriyi kapsar. Toplam Press ekranı sayısı bilinmediği için
              yüzde verilmez.
            </p>
            {countGroups.map((group) => (
              <>
                <p class="sitemap-count-title">{group.title}</p>
                {group.notes?.map((note) => (
                  <p>{note}</p>
                ))}
                <dl class="sitemap-counts" aria-label={group.title}>
                  {group.items.map((item) => (
                    <div>
                      <dt>{item.label}:</dt>
                      <dd>{item.count}</dd>
                    </div>
                  ))}
                </dl>
              </>
            ))}
            <p>
              <a
                class="sitemap-link sitemap-download"
                href={`${base}/press-sitemap.json`}
                download
              >
                İncelenmiş kayıtları JSON olarak indir
              </a>
            </p>
            <p>
              Arama dosyayı bir kez yükler. JSON bağlantısı JavaScript olmadan
              çalışır. İşlev doğrulanmamıştır.
            </p>
          </details>
        ) : (
          <p>
            Henüz yayımlanmış tarama verisi yok. İncelenmiş veri eklendiğinde
            harita burada görünecek.
          </p>
        )}
      </section>

      <section class="sitemap-section" aria-labelledby="tanimlar">
        <h2 id="tanimlar">Durumların anlamı</h2>
        <dl class="sitemap-definitions">
          {(Object.keys(statusDefinitions) as Status[]).map((status) => (
            <div>
              <dt>
                <span class="sitemap-status" data-status={status}>
                  {statusLabels[status]}
                </span>
              </dt>
              <dd>{statusDefinitions[status]}</dd>
            </div>
          ))}
        </dl>
        <h3>İşlev testi</h3>
        <p>
          “İncelendi” gözlem kaydıdır. Çalışma doğrulaması her öğenin “İşlev
          testi” satırında ayrıca belirtilir.
        </p>
      </section>
    </main>
    <footer class="wrap">
      <p>
        Kayıt değerleri, e-posta, iletişim bilgisi, tutar, anahtar ve müşteri
        tanımlayıcıları yayımlanmaz.
      </p>
    </footer>
    <script is:inline type="module" set:html={compiledSitemapScript} />
  </body>
</html>
