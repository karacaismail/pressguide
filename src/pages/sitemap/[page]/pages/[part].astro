---
import SitemapIndexPage from '../../../../components/SitemapIndexPage.astro';
import { buildSitemapPartitions } from '../../../../sitemap-partitions';
import { loadSitemap } from '../../../../sitemap';

export async function getStaticPaths() {
  const sitemap = await loadSitemap();
  const { childIndexParts } = buildSitemapPartitions(sitemap?.nodes ?? []);
  return childIndexParts.map((index) => ({
    params: { page: index.ownerId!, part: String(index.part) },
    props: { ownerId: index.ownerId!, part: index.part },
  }));
}

const { ownerId, part } = Astro.props as { ownerId: string; part: number };
---

<SitemapIndexPage ownerId={ownerId} part={part} />
