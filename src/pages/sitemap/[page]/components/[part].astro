---
import SitemapDetailPage from '../../../../components/SitemapDetailPage.astro';
import { buildSitemapPartitions } from '../../../../sitemap-partitions';
import { loadSitemap } from '../../../../sitemap';

export async function getStaticPaths() {
  const sitemap = await loadSitemap();
  const { metadataParts } = buildSitemapPartitions(sitemap?.nodes ?? []);
  // Part 1 is the canonical anchor URL.
  return metadataParts
    .filter((metadata) => metadata.part > 1)
    .map((metadata) => ({
      params: { page: metadata.anchor.id, part: String(metadata.part) },
      props: { anchorId: metadata.anchor.id, part: metadata.part },
    }));
}

const { anchorId, part } = Astro.props as { anchorId: string; part: number };
---

<SitemapDetailPage anchorId={anchorId} part={part} />
