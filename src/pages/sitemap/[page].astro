---
import SitemapDetailPage from '../../components/SitemapDetailPage.astro';
import { buildSitemapPartitions } from '../../sitemap-partitions';
import { loadSitemap } from '../../sitemap';

export async function getStaticPaths() {
  const sitemap = await loadSitemap();
  const { views } = buildSitemapPartitions(sitemap?.nodes ?? []);
  // `/sitemap/index/` is reserved for the global anchor index.
  const reserved = views.anchors.filter(
    (anchor) => encodeURIComponent(anchor.id) === 'index',
  );
  if (reserved.length > 0)
    throw new Error('sitemap anchor id "index" collides with the global index');
  return views.anchors.map((anchor) => ({
    params: { page: anchor.id },
    props: { anchorId: anchor.id },
  }));
}

const { anchorId } = Astro.props as { anchorId: string };
---

<SitemapDetailPage anchorId={anchorId} part={1} />
